{
  "name": "AI Email Agent (Template)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {
          "readStatus": "unread",
          "q": "-label:inbox_sent -category:promotions -category:social"
        },
        "simple": true,
        "maxResults": 10
      },
      "name": "New Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [0, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LITELLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"email-agent\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an email assistant for a small business. Write replies that sound like a real human, not a bot. Keep it under 100 words. Be helpful, friendly, and professional. Sign off with the name Ahmed.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Reply to this email:\\n\\nFrom: {{ $('New Email').item.json.from }}\\nSubject: {{ $('New Email').item.json.subject }}\\n\\n{{ $('New Email').item.json.snippet }}\"\n    }\n  ],\n  \"max_tokens\": 600,\n  \"temperature\": 0.75\n}",
        "options": {
          "timeout": 30000,
          "response": {
            "responseFormat": "json"
          }
        }
      },
      "name": "Draft Reply (LiteLLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [224, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "reply",
              "name": "reply",
              "value": "={{ $json.choices[0].message.content }}",
              "type": "string"
            },
            {
              "id": "sender",
              "name": "sender",
              "value": "={{ $('New Email').item.json.from }}",
              "type": "string"
            },
            {
              "id": "subject",
              "name": "subject",
              "value": "={{ $('New Email').item.json.subject }}",
              "type": "string"
            }
          ]
        }
      },
      "name": "Extract Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [448, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.sender }}",
        "subject": "=Re: {{ $json.subject }}",
        "message": "={{ $json.reply }}",
        "emailType": "html",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Send Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [672, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "markAsRead",
        "messageId": "={{ $('New Email').item.json.id }}"
      },
      "name": "Mark as Read",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [896, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
  "connections": {
    "New Email": {
      "main": [
        [
          {
            "node": "Draft Reply (LiteLLM)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft Reply (LiteLLM)": {
      "main": [
        [
          {
            "node": "Extract Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Reply": {
      "main": [
        [
          {
            "node": "Send Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Reply": {
      "main": [
        [
          {
            "node": "Mark as Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0
}
