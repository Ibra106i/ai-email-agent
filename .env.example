# AI Email Agent - Environment Variables
# Copy this file to .env and fill in your API keys

# ─── LLM Provider API Keys (at least one required) ───────────────────────────
# Get a free Groq key: https://console.groq.com
GROQ_API_KEY=

# Get a Mistral key: https://console.mistral.ai
MISTRAL_API_KEY=

# Get an OpenRouter key: https://openrouter.ai
OPENROUTER_API_KEY=

# ─── LiteLLM Master Key ───────────────────────────────────────────────────────
# Generate a random key for securing your LiteLLM gateway
# Example: openssl rand -hex 32
LITELLM_API_KEY=sk-your-master-key-here
